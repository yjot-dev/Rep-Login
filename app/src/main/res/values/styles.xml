<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Títulos -->
    <style name="MyTitleActivity" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">24sp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">40dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Texto -->
    <style name="MyTextActivity" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">18sp</item>
        <item name="android:textAlignment">textStart</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Items de adapter -->
    <style name="MyItemAdapter" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <!-- Inputs: TextInputLayout + TextInputEditText -->
    <style name="MyEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textSize">18sp</item>
        <item name="android:textAlignment">textStart</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColorHint">?attr/colorOnSecondary</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:maxLength">28</item>
    </style>

    <!-- Botones -->
    <style name="MyButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:maxWidth">320dp</item>
        <item name="iconTint">@null</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Botones de imagen -->
    <style name="MyImageButton" parent="Widget.MaterialComponents.Button.OutlinedButton.Icon">
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:layout_gravity">center</item>
    </style>

</resources>